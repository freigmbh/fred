# Backend image tag, a convex-backend commit sha. DASHBOARD_REV defaults to REV;
# set it separately when the dashboard image at that sha is broken.
REV=4d58e45bcf49d01ec696b31db7faec7362df45ad
DASHBOARD_REV=latest
# 64 hex characters. Generate with: openssl rand -hex 32
INSTANCE_SECRET=
INSTANCE_NAME=fred
PORT=3210
SITE_PROXY_PORT=3211
DASHBOARD_PORT=6791
# Leave empty for SQLite on the Docker volume. v1 sets a Postgres URL.
POSTGRES_URL=
# Keeps the backend from phoning home. Nothing but model calls leaves the network.
DISABLE_BEACON=true
